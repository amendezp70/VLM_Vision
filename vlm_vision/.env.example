# vlm_vision/.env.example
#
# Copy to .env and fill in the real secret values:
#   Windows:  copy .env.example .env
#   macOS:    cp .env.example .env
#
# .env holds REAL secrets and is git-ignored. NEVER commit .env.
# This .env.example is committed as documentation (no secrets here).

# --- AI models (Process 1 - bay agent) ---
MODEL_PATH=models/metwall.onnx
MODEL_DIR=models
MODEL_POLL_INTERVAL_SEC=3600

# --- Cameras ---
CAMERA_BAY1=0
CAMERA_BAY2=1
DETECTION_FPS=10

# --- Local services / ports ---
MODULA_WMS_URL=http://modula-wms.local:8080
WEBSOCKET_PORT=8765

# --- Local data paths ---
DB_PATH=data/picks.db
TRACEABILITY_DB_PATH=data/traceability.db
CLIP_REQUESTS_DIR=data/clip_requests
VIDEO_OUTPUT_DIR=data/video
VIDEO_CLIP_DIR=data/clips

# --- Traceability (Process 2) ---
BARCODE_MATCH_WINDOW_SEC=5.0
EVIDENCE_CLIP_MARGIN_SEC=30.0

# --- Video recorder (Process 3) ---
VIDEO_FPS=15
VIDEO_RESOLUTION=1920x1080
VIDEO_SEGMENT_MINUTES=5
VIDEO_RETENTION_DAYS=60
VIDEO_CAMERA_IDS=0,1

# --- Cloud sync (Zoho Catalyst) ---
# Non-secret IDs (safe to keep here):
CATALYST_PROJECT_ID=35344000000152001
CATALYST_FOLDER_EVIDENCE_CLIPS=35344000000205535
CATALYST_FOLDER_VIDEO_SEGMENTS=35344000000205524
CATALYST_FUNCTION_BASE_URL=https://YOUR_FUNCTION_BASE_URL/server/vlm_vision_function
CLOUD_SYNC_INTERVAL_SEC=60

# Secrets - leave BLANK here, fill only in your real .env:
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_REFRESH_TOKEN=
CATALYST_ACCOUNTS_URL=https://accounts.zoho.com
